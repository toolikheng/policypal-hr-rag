# PolicyPal configuration. Create your own copy with:  cp .env.example .env
# All values are local-development placeholders, not real secrets. Never commit .env.

# --- Database (PostgreSQL + pgvector) ---------------------------------------
POSTGRES_USER=policypal
POSTGRES_PASSWORD=policypal-local-dev
POSTGRES_DB=policypal
# Port for the database on your machine (it is 5432 inside Docker).
# 5433 avoids clashing with a PostgreSQL you may already run locally.
DB_HOST_PORT=5433
# Used when you run Python on your machine (tests, scripts). Inside Docker Compose,
# the api service gets its own DATABASE_URL that points at the "db" service.
DATABASE_URL=postgresql+psycopg://policypal:policypal-local-dev@localhost:5433/policypal
# Separate database used only by the test suite. It is created automatically the
# first time the database container starts (docker/db-init/).
TEST_DATABASE_URL=postgresql+psycopg://policypal:policypal-local-dev@localhost:5433/policypal_test

# --- LLM ----------------------------------------------------------------------
# ollama      = local model through Ollama (default)
# extractive  = no LLM: answers quote the most relevant policy text
LLM_PROVIDER=ollama
# Where Ollama listens when you run Python on your machine. Inside Docker Compose the
# api service is pointed at the "ollama" service instead.
OLLAMA_BASE_URL=http://localhost:11434
# Port for Ollama on your machine (bound to 127.0.0.1 only).
OLLAMA_HOST_PORT=11434
# The local model that writes answers. Docker Compose downloads it on the first start.
OLLAMA_MODEL=llama3.2:3b
# Give up on the model after this many seconds and quote the policy text instead.
# 120 leaves room for a cold start: the first answer after the model loads took 33-58 s
# on a CPU laptop (warm answers about 24 s).
OLLAMA_TIMEOUT_SECONDS=120

# --- Embeddings ---------------------------------------------------------------
# Local sentence-transformers model (no API key). It is downloaded once when the Docker
# image is built, so changing it needs `docker compose build`. It must produce
# 384-number vectors to fit the database column.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Questions (never policy passages) get the model card's query instruction in front of
# them: "Represent this sentence for searching relevant passages: ". To compare search
# results without it, uncomment the next line (an empty value turns it off).
# EMBEDDING_QUERY_INSTRUCTION=

# --- Retrieval ----------------------------------------------------------------
# How many of the most similar policy chunks each question retrieves (1-20).
RETRIEVAL_TOP_K=5
# Refuse ("I couldn't find this in the policies.") when the best chunk's similarity is
# below this (0-1). It is a similarity score, not a probability. 0.65 is a provisional
# value from a small set of hand-picked questions; it is calibrated in the evaluation.
MIN_SIMILARITY=0.65

# --- App ----------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR. Logs are JSON lines on stdout.
LOG_LEVEL=INFO
# Token for the admin endpoints (upload, re-ingest), sent in the X-Admin-Token header.
# A shared demo token, not real authentication. Change it; leave it empty to turn
# admin endpoints off.
ADMIN_TOKEN=change-me
# Largest policy file an admin may upload (1-50 MB).
MAX_UPLOAD_MB=5
# Where uploaded policies are saved (inside Docker: /app/uploads, a named volume).
UPLOAD_DIR=uploads
# Ports on your machine for the API (Swagger at /docs) and the Streamlit UI.
API_PORT=8000
UI_PORT=8501
# Docker image for the api and ui services. Local builds are tagged policypal:local.
POLICYPAL_IMAGE=policypal:local
